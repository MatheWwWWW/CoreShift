                                                        <TextBlock x:Name="FocusTrialStatus" Style="{StaticResource SecondaryText}" Text="{DynamicResource 'UI:Сравнить одинаковую нагрузку без профиля и с ним. Повторите один и тот же сценарий в обоих замерах.'}"
