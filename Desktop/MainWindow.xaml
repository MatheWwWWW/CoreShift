                                <TextBlock x:Name="DiagnosticActionStatus" Style="{StaticResource SecondaryText}" Visibility="Collapsed"
                                           Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
