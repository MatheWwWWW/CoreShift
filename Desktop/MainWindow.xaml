                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,6">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="{DynamicResource 'UI:Найти в процессах'}" Tag="{Binding Label}"
                                                            Click="FindSnapshotProcessClick" Padding="9,4" MinHeight="27" Margin="12,0,0,0" />
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Difference}" Margin="12,0,0,0"
                                                               Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="SnapshotCopyStatus" Style="{StaticResource SecondaryText}" Margin="0,7,0,0"
                                           Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                        </Grid>
                    </StackPanel>

            </Grid>
        </ScrollViewer>
        </Grid>

        <Grid x:Name="CommandOverlay" Grid.RowSpan="3" Panel.ZIndex="20" Visibility="Collapsed"
              shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Border Background="{DynamicResource Scrim}" MouseLeftButtonDown="DismissSearchClick" />
            <Border x:Name="CommandPanel" Style="{StaticResource Card}" Width="594" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,92,0,18" Padding="17"
                    KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Esc" Click="CloseSearchClick" Padding="9,4" MinHeight="27"
                                AutomationProperties.Name="{DynamicResource 'UI:Закрыть поиск'}" />
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource 'UI:Поиск разделов и действий'}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox x:Name="SearchQuery" TextChanged="SearchQueryChanged" AutomationProperties.Name="{DynamicResource 'UI:Поисковый запрос'}" />
                    <ListBox x:Name="SearchResults" Margin="0,9,0,0" MaxHeight="288"
                             Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}"
                             AutomationProperties.Name="{DynamicResource 'UI:Результаты поиска'}" PreviewMouseLeftButtonUp="SearchResultClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Category}" Style="{StaticResource SecondaryText}"
                                               FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="SearchEmpty" Text="{DynamicResource 'UI:Совпадений нет'}" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    <Border x:Name="WebHost" Visibility="Collapsed" Background="{DynamicResource Canvas}"
            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
    </Grid>
</Window>
