                                            Click="ChangeDiagnosticClick" Margin="0,0,8,6" />
                                    <Button Content="{DynamicResource 'UI:Диагностика и отзывы в Windows'}" Click="OpenWindowsLinkClick"
                                            Tag="ms-settings:privacy-feedback" Margin="0,0,0,6" />
