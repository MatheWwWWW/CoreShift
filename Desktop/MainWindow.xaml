<Window x:Class="CoreShift.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CoreShift" Width="1330" Height="850" MinWidth="920" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Canvas}"
        Foreground="{DynamicResource Text}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="{DynamicResource UiScale}"
        UseLayoutRounding="True" Loaded="OnLoaded" Closing="OnClosing" StateChanged="OnWindowStateChanged"
        PreviewKeyDown="WindowPreviewKeyDown" SourceInitialized="WindowSourceInitialized">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate x:Key="WindowsSettingCard">
            <Border Style="{StaticResource PolicyCard}">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" Margin="0,4,0,9" />
                    <WrapPanel>
                        <Button Tag="{Binding}" AutomationProperties.AutomationId="enable" Content="{DynamicResource 'UI:Включить'}" IsEnabled="{Binding CanEnable}" Click="ChangeWindowsSettingClick" Margin="0,0,6,0" />
                        <Button Tag="{Binding}" AutomationProperties.AutomationId="disable" Content="{DynamicResource 'UI:Отключить'}" IsEnabled="{Binding CanDisable}" Click="ChangeWindowsSettingClick" Margin="0,0,6,0" />
                        <Button Tag="{Binding}" AutomationProperties.AutomationId="restore" Content="{DynamicResource 'UI:Восстановить'}" IsEnabled="{Binding CanRestore}" Click="ChangeWindowsSettingClick" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="WindowsTweakCard">
            <Border Style="{StaticResource PolicyCard}">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding State}" Foreground="{DynamicResource Violet}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" Margin="0,5,0,0" />
                    <TextBlock Text="{Binding Risk}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="{DynamicResource 'UI:Применить'}" Tag="{Binding}" IsEnabled="{Binding CanApply}"
                                Style="{StaticResource PrimaryButton}" Click="ApplyTweakClick" Margin="0,0,8,0" />
                        <Button Content="{DynamicResource 'UI:Восстановить'}" Tag="{Binding}" IsEnabled="{Binding CanRestore}" Click="RestoreTweakClick" />
                        <Button Content="{DynamicResource 'UI:Параметры пользователя'}" Tag="{Binding SettingsUri}" Click="OpenTweakSettingsClick" Margin="8,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SettingsUri}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid>
    <Grid x:Name="WindowSurface" Background="{DynamicResource Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.RowSpan="3" IsHitTestVisible="False">
          <Viewbox Stretch="UniformToFill" ClipToBounds="True" Opacity=".65">
            <Canvas Width="1200" Height="760">
              <Path Stroke="{DynamicResource CircuitTrace}" StrokeThickness="1" Data="M 0,160 H 172 L 238,94 H 448 L 490,52 H 1170 M 0,195 H 199 L 254,140 H 501 L 522,118 H 1050 M 1200,288 H 1042 L 956,374 H 826 L 762,438 H 541 M 1200,329 H 1075 L 1008,396 H 862 L 798,460 H 655 M 1200,678 H 1030 L 985,633 H 760 L 712,585 H 570 M 1200,700 H 990 L 947,657 H 748 M 0,610 H 184 L 244,550 H 442" />
            </Canvas>
          </Viewbox>
          <Rectangle>
            <Rectangle.Fill>
              <RadialGradientBrush Center=".25,0" GradientOrigin=".25,0" RadiusX=".72" RadiusY=".64">
                <GradientStop Color="{DynamicResource BackdropHalo}" Offset="0" />
                <GradientStop Color="{DynamicResource BackdropHaloClear}" Offset="1" />
              </RadialGradientBrush>
            </Rectangle.Fill>
          </Rectangle>
          <Rectangle>
            <Rectangle.Fill>
              <RadialGradientBrush Center=".95,.9" GradientOrigin=".95,.9" RadiusX=".55" RadiusY=".55">
                <GradientStop Color="{DynamicResource BackdropSide}" Offset="0" />
                <GradientStop Color="{DynamicResource BackdropSideClear}" Offset="1" />
              </RadialGradientBrush>
            </Rectangle.Fill>
          </Rectangle>
        </Grid>
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Background="{DynamicResource GlassRail}">
            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="206" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="22,0">
                    <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource Accent}" VerticalAlignment="Center">
                        <Path Data="{StaticResource CoreShiftMark}"
                              Stroke="{DynamicResource AccentText}" StrokeThickness="1.4" StrokeLineJoin="Round"
                              Width="17" Height="17" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="CoreShift" FontWeight="SemiBold" FontSize="20" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="OpenSearchButton" Click="OpenSearchClick"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center"
                        Width="340" HorizontalAlignment="Right" Margin="18,0,18,0" Background="{DynamicResource GlassCard}" HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="{DynamicResource 'UI:Поиск разделов и действий'}">
                    <DockPanel>
                        <Path DockPanel.Dock="Left" Data="{StaticResource SearchIcon}" Stroke="{DynamicResource Accent}"
                              Width="15" Height="15" StrokeThickness="1.6" Stretch="Uniform" Margin="0,0,10,0" />
                        <Border DockPanel.Dock="Right" CornerRadius="5" Background="{DynamicResource Canvas}" Padding="6,1" Margin="8,0,0,0">
                            <TextBlock Text="Ctrl+K" FontSize="11" Foreground="{DynamicResource Muted}" />
                        </Border>
                        <TextBlock Text="{DynamicResource 'UI:Поиск разделов и действий'}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Button>
                <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="SettingsButton" Style="{StaticResource GearButton}" ToolTip="{DynamicResource 'UI:Настройки'}" AutomationProperties.Name="{DynamicResource 'UI:Настройки'}" Click="OpenSettingsClick">
                        <Path Data="{StaticResource SettingsIcon}" Stroke="{DynamicResource Muted}" Width="15" Height="15"
                              StrokeThickness="1.5" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource TitleButton}" ToolTip="{DynamicResource 'UI:Свернуть'}" AutomationProperties.Name="{DynamicResource 'UI:Свернуть'}" Click="MinimizeClick">
                        <Path Data="M 0,5 H 10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleButton}" ToolTip="{DynamicResource 'UI:Развернуть'}"
                            AutomationProperties.Name="{DynamicResource 'UI:Развернуть'}" Click="MaximizeClick">
                        <Path x:Name="MaximizeGlyph" Data="M 0,0 H 9 V 9 H 0 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource CloseTitleButton}" ToolTip="{DynamicResource 'UI:Свернуть в трей'}"
                            AutomationProperties.Name="{DynamicResource 'UI:Свернуть в трей'}" Click="CloseClick">
                        <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="UpdateBanner" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Accent}" BorderThickness="0,0,0,1" Padding="20,10">
            <DockPanel>
                <Button x:Name="InstallUpdateButton" DockPanel.Dock="Right" Content="{DynamicResource 'UI:Установить'}"
                        Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Margin="16,0,0,0"
                        Click="InstallUpdateClick" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource 'UI:Вышла новая версия приложения'}" FontWeight="SemiBold" />
                    <TextBlock x:Name="UpdateStatus" Style="{StaticResource SecondaryText}" Margin="0,3,0,0"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="205" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource GlassRail}" BorderBrush="{DynamicResource Line}"
                    BorderThickness="0,0,1,0" Padding="10,16,10,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource 'UI:Система'}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="9,8,0,7" />
                        <RadioButton x:Name="OverviewNav" Content="{DynamicResource 'UI:Обзор'}" Tag="{StaticResource OverviewIcon}"
                                     IsChecked="True" GroupName="Navigation" Style="{StaticResource NavButton}" Checked="Navigate" />
                        <RadioButton x:Name="PcInfoNav" Content="{DynamicResource 'UI:О компьютере'}" Tag="{StaticResource PcInfoIcon}"
                                     GroupName="Navigation" Style="{StaticResource NavButton}" Checked="Navigate" />
                        <RadioButton x:Name="MemoryNav" Content="{DynamicResource 'UI:Память'}" Tag="{StaticResource MemoryIcon}"
                                     GroupName="Navigation" Style="{StaticResource NavButton}" Checked="Navigate" />
                        <TextBlock Text="{DynamicResource 'UI:Обслуживание'}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="9,8,0,7" />
                        <RadioButton x:Name="CleanNav" Content="{DynamicResource 'UI:Очистка'}" Tag="{StaticResource CleanIcon}"
                                     GroupName="Navigation" Style="{StaticResource NavButton}" Checked="Navigate" />
                        <RadioButton x:Name="TweaksNav" Content="{DynamicResource 'UI:Оптимизация'}" Tag="{StaticResource TweaksIcon}"
                                     GroupName="Navigation" Style="{StaticResource NavButton}" Checked="Navigate" />
                        <RadioButton x:Name="PackagesNav" Content="{DynamicResource 'UI:UWP-приложения'}" Tag="{StaticResource PackagesIcon}"
                                     GroupName="Navigation" Style="{StaticResource NavButton}" Checked="Navigate" />
                        <RadioButton x:Name="PersonalizationNav" Content="{DynamicResource 'UI:Персонализация'}" Tag="{StaticResource SettingsIcon}"
                                     GroupName="Navigation" Style="{StaticResource NavButton}" Checked="Navigate" />
                        <RadioButton x:Name="PrivacyNav" Content="{DynamicResource 'UI:Телеметрия'}" Tag="{StaticResource PrivacyIcon}"
                                     GroupName="Navigation" Style="{StaticResource NavButton}" Checked="Navigate" />
                        <TextBlock Text="{DynamicResource 'UI:Сеансы'}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="9,8,0,7" />
                        <RadioButton x:Name="ProfileNav" Content="{DynamicResource 'UI:Профиль фокуса'}" Tag="{StaticResource FocusIcon}"
                                     GroupName="Navigation" Style="{StaticResource NavButton}" Checked="Navigate" />
                        <RadioButton x:Name="SnapshotsNav" Content="{DynamicResource 'UI:До и после'}" Tag="{StaticResource SnapshotIcon}"
                                     GroupName="Navigation" Style="{StaticResource NavButton}" Checked="Navigate" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <ScrollViewer x:Name="PageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="PageContent" Margin="28,22,28,24" MaxWidth="1490">
                <StackPanel x:Name="OverviewPage">
                    <DockPanel Margin="0,0,0,14">
                        <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Button x:Name="RefreshComponentsButton" Content="{DynamicResource 'UI:Обновить'}"
                                    AutomationProperties.Name="{DynamicResource 'UI:Обновить компоненты'}" Click="RefreshComponentsClick" Margin="0,0,8,0" />
                            <Button Content="{DynamicResource 'UI:До и после'}" Click="OpenSnapshotsClick" />
                        </WrapPanel>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource 'UI:Обзор системы'}" Style="{StaticResource PageTitle}" />
                            <WrapPanel Margin="0,4,0,0">
                                <TextBlock x:Name="HostNameText" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"
                                           Margin="0,0,9,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="ComponentWindows" Style="{StaticResource SecondaryText}"
                                           Margin="0,0,10,0" VerticalAlignment="Center" />
                                <Border Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}"
                                        BorderThickness="1" Padding="8,3" CornerRadius="6" Margin="0,2,0,0">
                                    <TextBlock x:Name="RefreshStatus" Text="{DynamicResource 'UI:Получаем данные Windows…'}"
                                               Foreground="{DynamicResource Text}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </DockPanel>

                    <UniformGrid Columns="3" Margin="0,0,-10,13">
                        <Border Style="{StaticResource ComponentTile}" Margin="0,0,10,0" Padding="14"
                                MouseEnter="DashboardCardEnter" MouseMove="DashboardCardMove" MouseLeave="DashboardCardLeave"
                                IsVisibleChanged="DashboardCardVisibilityChanged">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource 'UI:Загрузка процессора'}" Style="{StaticResource SecondaryText}" />
                                <TextBlock x:Name="CpuLoadText" Text="—" Style="{StaticResource MetricValue}" Margin="0,1,0,4" />
                                <Border Height="43" BorderBrush="{DynamicResource HeroGrid}" BorderThickness="0,1,0,1">
                                    <Canvas x:Name="CpuTrendPlot" SizeChanged="CpuTrendSizeChanged" ClipToBounds="True">
                                        <Path x:Name="CpuTrendLine" Stroke="{DynamicResource Accent}" StrokeThickness="1.7" StrokeLineJoin="Round" />
                                    </Canvas>
                                </Border>
                                <TextBlock Text="{DynamicResource 'UI:История нагрузки'}" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ComponentTile}" Margin="0,0,10,0" Padding="14"
                                MouseEnter="DashboardCardEnter" MouseMove="DashboardCardMove" MouseLeave="DashboardCardLeave"
                                IsVisibleChanged="DashboardCardVisibilityChanged">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource 'UI:Оперативная память'}" Style="{StaticResource SecondaryText}" />
                                <TextBlock x:Name="RamPercent" Text="—" Style="{StaticResource MetricValue}" Margin="0,1,0,4" />
                                <Border Height="43" BorderBrush="{DynamicResource HeroGrid}" BorderThickness="0,1,0,1">
                                    <Canvas x:Name="RamTrendPlot" SizeChanged="RamTrendSizeChanged" ClipToBounds="True">
                                        <Path x:Name="RamTrendLine" Stroke="{DynamicResource Violet}" StrokeThickness="1.7" StrokeLineJoin="Round" />
                                    </Canvas>
                                </Border>
                                <TextBlock x:Name="RamUsage" Text="—" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,6,0,0" />
                                <TextBlock x:Name="RamAvailable" Style="{StaticResource SecondaryText}" FontSize="12" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ComponentTile}" Margin="0,0,10,0" Padding="14"
                                MouseEnter="DashboardCardEnter" MouseMove="DashboardCardMove" MouseLeave="DashboardCardLeave"
                                IsVisibleChanged="DashboardCardVisibilityChanged">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource 'UI:Свободно на диске Windows'}" Style="{StaticResource SecondaryText}" />
                                <TextBlock x:Name="SystemDiskFreeText" Text="—" Style="{StaticResource MetricValue}" TextWrapping="Wrap" Margin="0,1,0,8" />
                                <ProgressBar x:Name="SystemDiskMeter" Style="{StaticResource MemoryUsageMeter}" Maximum="100" Margin="0,5,0,9" />
                                <TextBlock x:Name="SystemDiskVolumeText" Text="—" Style="{StaticResource SecondaryText}" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource Card}" Padding="15">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Button x:Name="BoardResetButton" Content="{DynamicResource 'UI:Сбросить вид'}" Click="ResetBoardClick"
                                            Visibility="Collapsed" Margin="0,0,7,0" />
                                    <Button x:Name="BoardModeToggle" Content="{DynamicResource 'UI:Открыть 3D'}" Click="ToggleBoardClick" />
                                </WrapPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource 'UI:Схема компьютера'}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="BoardHint" Text="{DynamicResource 'UI:Выберите компонент, чтобы увидеть показания.'}"
                                               Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,3,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.6*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" MinWidth="178" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource BoardSurface}" BorderBrush="{DynamicResource Line}"
                                        BorderThickness="1" CornerRadius="11" ClipToBounds="True" MinHeight="202">
                                    <Grid>
                                        <Path Stretch="Fill" Margin="14" Stroke="{DynamicResource CircuitTrace}" StrokeThickness="1"
                                              IsHitTestVisible="False" Data="M 0,2 H 16 L 30,16 H 80 M 0,8 H 13 L 27,22 H 82 M 100,19 H 93 L 78,34 H 56 M 100,25 H 96 L 81,40 H 61 M 0,68 H 34 L 44,58 H 71" />
                                        <Grid x:Name="BoardPlan" Margin="11">
                                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <RadioButton x:Name="BoardCpu" Tag="Cpu" GroupName="BoardParts" Style="{StaticResource BoardPartButton}"
                                                         Checked="BoardPartChecked" Margin="0,0,6,6" IsChecked="True"
                                                         AutomationProperties.Name="{DynamicResource 'UI:Процессор'}">
                                                <StackPanel>
                                                    <Path Data="{StaticResource BoardCpuIcon}" Style="{StaticResource BoardPartIcon}" />
                                                    <TextBlock Text="{DynamicResource 'UI:Процессор'}" Style="{StaticResource BoardPartLabel}" />
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="BoardMemory" Grid.Column="1" Tag="Memory" GroupName="BoardParts"
                                                         Style="{StaticResource BoardPartButton}" Checked="BoardPartChecked" Margin="6,0,0,6"
                                                         AutomationProperties.Name="{DynamicResource 'UI:Память'}">
                                                <StackPanel>
                                                    <Path Data="{StaticResource BoardMemoryIcon}" Style="{StaticResource BoardPartIcon}" />
                                                    <TextBlock Text="{DynamicResource 'UI:Память'}" Style="{StaticResource BoardPartLabel}" />
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="BoardGraphics" Grid.Row="1" Tag="Graphics" GroupName="BoardParts"
                                                         Style="{StaticResource BoardPartButton}" Checked="BoardPartChecked" Margin="0,6,6,0"
                                                         MouseEnter="BoardGraphicsEnter" MouseLeave="BoardGraphicsLeave" IsVisibleChanged="BoardGraphicsVisibilityChanged"
                                                         AutomationProperties.Name="{DynamicResource 'UI:Видеокарта'}">
                                                <StackPanel>
                                                    <Grid HorizontalAlignment="Center">
                                                        <Path Data="{StaticResource BoardGpuIcon}" Style="{StaticResource BoardPartIcon}" />
                                                        <Path Data="{StaticResource BoardFanIcon}" Style="{StaticResource BoardPartIcon}" Width="11" Height="11"
                                                              StrokeThickness=".9" Margin="7,0,0,3" HorizontalAlignment="Left" RenderTransformOrigin=".5,.5">
                                                            <Path.RenderTransform><RotateTransform x:Name="GraphicsFanRotation" /></Path.RenderTransform>
                                                        </Path>
                                                    </Grid>
                                                    <TextBlock Text="{DynamicResource 'UI:Видеокарта'}" Style="{StaticResource BoardPartLabel}" />
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="BoardStorage" Grid.Row="1" Grid.Column="1" Tag="Storage" GroupName="BoardParts"
                                                         Style="{StaticResource BoardPartButton}" Checked="BoardPartChecked" Margin="6,6,0,0"
                                                         AutomationProperties.Name="{DynamicResource 'UI:Накопитель'}">
                                                <StackPanel>
                                                    <Path Data="{StaticResource BoardStorageIcon}" Style="{StaticResource BoardPartIcon}" />
                                                    <TextBlock Text="{DynamicResource 'UI:Накопитель'}" Style="{StaticResource BoardPartLabel}" />
                                                </StackPanel>
                                            </RadioButton>
                                        </Grid>
                                        <Border x:Name="BoardHost" Height="236" Visibility="Collapsed" Background="Transparent"
                                                AutomationProperties.Name="{DynamicResource 'UI:Интерактивная схема компьютера'}" />
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}"
                                        BorderThickness="1" CornerRadius="11" Padding="12">
                                    <StackPanel>
                                        <TextBlock x:Name="BoardSelectionLabel" Style="{StaticResource SecondaryText}" FontSize="12" />
                                        <TextBlock x:Name="BoardSelectionName" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,6" />
                                        <TextBlock x:Name="BoardSelectionReading" Style="{StaticResource MetricValue}" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="BoardSelectionDetail" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,6,0,11" />
                                        <Button Content="{DynamicResource 'UI:Подробнее'}" Click="OpenBoardDetailsClick" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <WrapPanel x:Name="BoardKeys" Visibility="Collapsed" Margin="0,9,0,0">
                                <Button Content="{DynamicResource 'UI:Процессор'}" Tag="Cpu" Click="BoardKeyClick" Margin="0,0,6,3" />
                                <Button Content="{DynamicResource 'UI:Видеокарта'}" Tag="Graphics" Click="BoardKeyClick" Margin="0,0,6,3" />
                                <Button Content="{DynamicResource 'UI:Память'}" Tag="Memory" Click="BoardKeyClick" Margin="0,0,6,3" />
                                <Button Content="{DynamicResource 'UI:Накопитель'}" Tag="Storage" Click="BoardKeyClick" Margin="0,0,6,3" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <WrapPanel Margin="0,12,0,12" HorizontalAlignment="Right">
                        <Button x:Name="OverviewFocusButton" Content="{DynamicResource 'UI:Открыть профиль фокуса'}"
                                Click="OpenProfileClick" Margin="0,0,8,0" />
                        <Button Content="{DynamicResource 'UI:Открыть очистку'}" Click="OpenCleanClick" />
                    </WrapPanel>
                    <Border Style="{StaticResource Card}">
                        <Expander x:Name="OverviewDetails" Style="{StaticResource DetailsExpander}"
                                  Header="{DynamicResource 'UI:Система, сеть и подкачка'}" Expanded="OverviewDetailsExpanded">
                            <StackPanel Margin="0,6,0,0">
                                <UniformGrid Columns="3" Margin="0,0,0,12">
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="{DynamicResource 'UI:Мониторы'}" Style="{StaticResource SecondaryText}" FontSize="12" />
                                        <TextBlock x:Name="ComponentDisplay" Text="—" FontWeight="SemiBold" />
                                        <TextBlock x:Name="ComponentDisplayDetail" Style="{StaticResource SecondaryText}" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="{DynamicResource 'UI:Сеть'}" Style="{StaticResource SecondaryText}" FontSize="12" />
                                        <TextBlock x:Name="ComponentNetwork" Text="—" FontWeight="SemiBold" />
                                        <TextBlock x:Name="ComponentNetworkDetail" Style="{StaticResource SecondaryText}" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock x:Name="ComponentPower" Text="—" FontWeight="SemiBold" />
                                        <TextBlock x:Name="ComponentPowerDetail" Style="{StaticResource SecondaryText}" FontSize="12" />
                                        <TextBlock x:Name="ComponentUptime" Style="{StaticResource SecondaryText}" FontSize="12" />
                                    </StackPanel>
                                </UniformGrid>
                                <UniformGrid Columns="3" Margin="0,5,0,9">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource 'UI:Пик выделенной памяти'}" Style="{StaticResource SecondaryText}" FontSize="12" />
                                        <TextBlock x:Name="CommitPeak" Text="—" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource 'UI:Лимит выделения'}" Style="{StaticResource SecondaryText}" FontSize="12" />
                                        <TextBlock x:Name="CommitLimit" Text="—" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource 'UI:Файл подкачки'}" Style="{StaticResource SecondaryText}" FontSize="12" />
                                        <TextBlock x:Name="PagefileCurrent" Text="—" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock x:Name="PagefileDetail" Style="{StaticResource SecondaryText}" />
                                <ItemsControl x:Name="PagefileItems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,5,0,3">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Usage}" Style="{StaticResource SecondaryText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </Border>
                </StackPanel>

                    <StackPanel x:Name="PcInfoPage" Visibility="Collapsed">
                        <DockPanel x:Name="PcInfoHeader" Margin="0,0,0,17">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button x:Name="PcInfoRefreshButton" Content="{DynamicResource 'UI:Обновить'}" Click="RefreshPcInfoClick" Margin="0,0,8,0" />
                                <Button Content="{DynamicResource 'UI:Развернуть или свернуть всё'}" Click="ExpandPcInfoClick" Margin="0,0,8,0" />
                                <Button x:Name="PcInfoCopyButton" Content="{DynamicResource 'UI:Скопировать отчёт'}" Click="CopyPcInfoClick" IsEnabled="False" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource 'UI:О компьютере'}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock x:Name="PcInfoStatus" Style="{StaticResource SecondaryText}" FontSize="14" Margin="0,0,0,12" Visibility="Collapsed"
                                   Text="{DynamicResource 'UI:Получаем сведения о компьютере…'}" AutomationProperties.LiveSetting="Polite" />
                        <ItemsControl x:Name="PcInfoSummary" Margin="0,0,-12,4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="16,14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource SecondaryText}" FontSize="14" />
                                            <TextBlock Text="{Binding Value}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Detail}" Margin="0,4,0,0" FontSize="14">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl x:Name="PcInfoItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Style="{StaticResource DetailsExpander}" IsExpanded="{Binding Expanded, Mode=TwoWay}" Margin="0,0,0,10">
                                        <Expander.Header>
                                            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" FontSize="18" TextWrapping="Wrap" />
                                        </Expander.Header>
                                        <Border Style="{StaticResource Card}" Padding="16,6">
                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,7">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="205" />
                                                                    <ColumnDefinition />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Label}" FontSize="14" LineHeight="23" Margin="0,0,18,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="16" FontWeight="Medium"
                                                                           LineHeight="23" TextWrapping="Wrap" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="MemoryPage" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource 'UI:Память'}" Margin="0,0,0,17" />
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="{DynamicResource 'UI:Доступно ОЗУ'}" />
                                        <TextBlock x:Name="DiagnosticRam" Style="{StaticResource MetricValue}" Text="—" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="{DynamicResource 'UI:Выделено Windows'}" />
                                        <TextBlock x:Name="DiagnosticCommit" Style="{StaticResource MetricValue}" Text="—" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="{DynamicResource 'UI:Запас до лимита'}" />
                                        <TextBlock x:Name="DiagnosticHeadroom" Style="{StaticResource MetricValue}" Text="—" TextWrapping="Wrap" />
                                    </StackPanel>
                                </UniformGrid>
                                <WrapPanel Margin="0,9,0,0">
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="{DynamicResource 'UI:Системный кэш'}" Margin="0,0,8,0" />
                                    <TextBlock x:Name="DiagnosticSystemCache" Text="—" FontWeight="SemiBold" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource 'UI:История за 15 минут'}" Margin="0,18,0,8" />
                                <WrapPanel Margin="0,0,0,8">
                                    <TextBlock Text="{DynamicResource 'UI:●  Занято ОЗУ'}" Foreground="{DynamicResource Accent}" Margin="0,0,16,0" />
                                    <TextBlock Text="{DynamicResource 'UI:●  Выделено от текущего лимита'}" Foreground="{DynamicResource Violet}" />
                                </WrapPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="106" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid x:Name="MemoryHistoryAxis" Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="100%" VerticalAlignment="Top" />
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="50%" VerticalAlignment="Center" />
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="0%" VerticalAlignment="Bottom" />
                                    </Grid>
                                    <Grid x:Name="MemoryHistoryPanel" Grid.Column="1" Background="{DynamicResource Canvas}" AutomationProperties.Name="{DynamicResource 'UI:История загрузки памяти'}">
                                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1" />
                                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" VerticalAlignment="Center" />
                                        <Canvas x:Name="MemoryHistoryPlot" ClipToBounds="True" SizeChanged="MemoryHistorySizeChanged">
                                            <Path x:Name="RamHistoryLine" Stroke="{DynamicResource Accent}" StrokeThickness="2" />
                                            <Path x:Name="CommitHistoryLine" Stroke="{DynamicResource Violet}" StrokeThickness="2" StrokeDashArray="3,2" />
                                        </Canvas>
                                        <TextBlock x:Name="MemoryHistoryStatus" Style="{StaticResource SecondaryText}"
                                                   Text="{DynamicResource 'UI:Собираем первые замеры…'}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8" />
                                    </Grid>
                                    <DockPanel x:Name="MemoryHistoryTimes" Grid.Row="1" Grid.Column="1" Margin="0,5,0,0">
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="{DynamicResource 'UI:Сейчас'}" DockPanel.Dock="Right" />
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="{DynamicResource 'UI:15 минут назад'}" />
                                    </DockPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource 'UI:Приложения и процессы'}" />
                                <Grid Margin="0,12,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="224" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <Label Content="{DynamicResource 'UI:Имя процесса или PID'}" Target="{Binding ElementName=MemoryProcessSearch}"
                                               Foreground="{DynamicResource Muted}" Padding="0,0,0,5" />
                                        <TextBox x:Name="MemoryProcessSearch" TextChanged="MemoryProcessSearchChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <Label Content="{DynamicResource 'UI:Сортировка'}" Target="{Binding ElementName=MemoryProcessSort}"
                                               Foreground="{DynamicResource Muted}" Padding="0,0,0,5" />
                                        <ComboBox x:Name="MemoryProcessSort" Style="{StaticResource DarkComboBox}"
                                                  SelectedIndex="0" SelectionChanged="MemoryProcessSortChanged">
                                            <ComboBoxItem Content="{DynamicResource 'UI:По объёму ОЗУ'}" />
                                            <ComboBoxItem Content="{DynamicResource 'UI:По приросту в ОЗУ'}" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource Canvas}">
                                    <StackPanel Grid.IsSharedSizeScope="True">
                                        <Border Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}"
                                                BorderThickness="0,0,0,1" CornerRadius="7,7,0,0" Padding="12,8,25,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="62" SharedSizeGroup="ProcessIdColumn" />
                                                    <ColumnDefinition Width="98" SharedSizeGroup="WorkingSetColumn" />
                                                    <ColumnDefinition Width="118" SharedSizeGroup="GrowthColumn" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource SecondaryText}" Text="{DynamicResource 'UI:Процесс'}" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource SecondaryText}" Text="PID" TextAlignment="Right" />
                                                <TextBlock Grid.Column="2" Style="{StaticResource SecondaryText}" Text="{DynamicResource 'UI:В ОЗУ'}" TextAlignment="Right" />
                                                <TextBlock Grid.Column="3" Style="{StaticResource SecondaryText}" Text="{DynamicResource 'UI:Изм. за 2 мин'}" TextAlignment="Right" />
                                            </Grid>
                                        </Border>
                                        <Grid>
                                            <ListBox x:Name="MemoryProcesses" MaxHeight="234" MinHeight="44" Background="Transparent"
                                                     BorderThickness="0" Padding="0" Foreground="{DynamicResource Text}"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible"
                                                     AutomationProperties.Name="{DynamicResource 'UI:Процессы и использование ОЗУ'}" SelectionChanged="MemoryProcessSelectionChanged">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                        <Setter Property="Padding" Value="12,7" />
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition />
                                                                <ColumnDefinition SharedSizeGroup="ProcessIdColumn" />
                                                                <ColumnDefinition SharedSizeGroup="WorkingSetColumn" />
                                                                <ColumnDefinition SharedSizeGroup="GrowthColumn" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,8,0" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Pid}" Foreground="{DynamicResource Muted}" TextAlignment="Right" />
                                                            <TextBlock Grid.Column="2" Text="{Binding WorkingSet}" FontFamily="Cascadia Mono, Consolas" TextAlignment="Right" />
                                                            <TextBlock Grid.Column="3" Text="{Binding Growth}" FontFamily="Cascadia Mono, Consolas" TextAlignment="Right" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock x:Name="MemoryProcessNoMatches" Text="{DynamicResource 'UI:Процессы не найдены'}" Visibility="Collapsed"
                                                       Style="{StaticResource SecondaryText}" Margin="12,8"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                                       AutomationProperties.LiveSetting="Polite" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="MemoryProcessStatus" Style="{StaticResource SecondaryText}" Text="{DynamicResource 'UI:Получаем список процессов…'}" Margin="0,8,0,0" />
                                <Border Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                        CornerRadius="8" Padding="12" Margin="0,12,0,0">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button x:Name="TrimButton" Content="{DynamicResource 'UI:Сбросить рабочий набор'}" IsEnabled="False" Click="TrimClick"
                                                    DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="MemoryProcessSelection" FontWeight="SemiBold" TextWrapping="Wrap"
                                                           Text="{DynamicResource 'UI:Выберите процесс в таблице'}" />
                                                <TextBlock x:Name="MemoryProcessActionHint" Style="{StaticResource SecondaryText}"
                                                           Margin="0,3,0,0" Visibility="Collapsed" />
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock x:Name="TrimStatus" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border x:Name="MemoryTrimGroup" Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource 'UI:Сброс ОЗУ для выбранных процессов'}" />
                                <TextBlock Style="{StaticResource SecondaryText}" Text="{DynamicResource 'UI:Выбирайте процессы в таблице выше и добавляйте их в очередь. Windows может снова загрузить эти страницы.'}" />
                                <TextBlock x:Name="MemoryTrimQueueText" Text="—" TextWrapping="Wrap" Margin="0,5,0,7" />
                                <WrapPanel>
                                    <Button x:Name="QueueMemoryProcessButton" Content="{DynamicResource 'UI:Добавить выбранный'}" IsEnabled="False" Click="QueueMemoryProcessClick" Margin="0,0,8,0" />
                                    <Button x:Name="RunMemoryTrimQueueButton" Content="{DynamicResource 'UI:Сбросить очередь'}" IsEnabled="False" Click="TrimMemoryQueueClick" Margin="0,0,8,0" />
                                    <Button x:Name="ClearMemoryTrimQueueButton" Content="{DynamicResource 'UI:Очистить список'}" IsEnabled="False" Click="ClearMemoryQueueClick" />
                                </WrapPanel>
                                <TextBlock x:Name="MemoryTrimQueueStatus" Style="{StaticResource SecondaryText}" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="MemoryPagefileCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource 'UI:Файл подкачки'}" />
                                <TextBlock x:Name="PagefileMode" Style="{StaticResource SecondaryText}" Text="{DynamicResource 'UI:Читаем настройки Windows…'}" Margin="0,6,0,0" />
                                <TextBlock x:Name="DiagnosticPagefileStatus" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" Visibility="Collapsed" />
                                <ItemsControl x:Name="DiagnosticPagefiles">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}"
                                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <UniformGrid Columns="3" Margin="0,9,0,0">
                                                        <StackPanel Margin="0,0,10,0">
                                                            <TextBlock Text="{DynamicResource 'UI:Занято / выделено'}" Style="{StaticResource SecondaryText}" />
                                                            <TextBlock Text="{Binding Allocation}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,10,0">
                                                            <TextBlock Text="{DynamicResource 'UI:Пик использования'}" Style="{StaticResource SecondaryText}" />
                                                            <TextBlock Text="{Binding Peak}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="{DynamicResource 'UI:Свободно на диске'}" Style="{StaticResource SecondaryText}" />
                                                            <TextBlock Text="{Binding FreeSpace}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                        </StackPanel>
                                                    </UniformGrid>
                                                    <ProgressBar Value="{Binding UsagePercent, Mode=OneWay}" Maximum="100" Margin="0,10,0,0"
                                                                 AutomationProperties.Name="{DynamicResource 'UI:Использование выделенного файла подкачки'}">
                                                        <ProgressBar.Style>
                                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource MemoryUsageMeter}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasUsage}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ProgressBar.Style>
                                                    </ProgressBar>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="MemoryPressureStatus" Style="{StaticResource SecondaryText}" Visibility="Collapsed" Margin="0,8,0,0" />
                                <Expander Header="{DynamicResource 'UI:Оценка размера и системные дампы'}" Style="{StaticResource DetailsExpander}" Margin="0,12,0,0">
                                    <TextBlock x:Name="MemoryAdvice" Style="{StaticResource SecondaryText}" />
                                </Expander>
                                <DockPanel Margin="0,12,0,0">
                                    <Button Content="{DynamicResource 'UI:Открыть параметры системы'}" Click="OpenPagefileSettingsClick" Margin="0,0,12,0" />
                                    <TextBlock Style="{StaticResource SecondaryText}" VerticalAlignment="Center"
                                               Text="{DynamicResource 'UI:Быстродействие → Параметры → Дополнительно → Виртуальная память'}" />
                                </DockPanel>
                                <TextBlock x:Name="PagefileSettingsStatus" Style="{StaticResource SecondaryText}" Visibility="Collapsed" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="CleanPage" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource 'UI:Очистка Temp'}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{DynamicResource 'UI:Перед удалением вы увидите список файлов. Занятые файлы пропускаются.'}" Margin="0,4,0,17" />
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width=".85*" />
                                <ColumnDefinition Width="15" />
                                <ColumnDefinition Width="1.15*" />
                            </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <StackPanel><TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource 'UI:Категории очистки'}" Margin="0,0,0,13" />
                                <UniformGrid x:Name="CleanCategoryChoices" Columns="1" Margin="-4,-4,-4,12">
                                    <UniformGrid.Resources>
                                        <Style TargetType="CheckBox" BasedOn="{StaticResource CleanupOption}" />
                                    </UniformGrid.Resources>
                                    <CheckBox x:Name="CleanTemp" Content="{DynamicResource 'UI:Папки Temp'}" IsChecked="True"
                                              AutomationProperties.HelpText="{DynamicResource 'UI:Временные файлы Windows и приложений старше суток.'}" />
                                    <CheckBox x:Name="CleanThumbnails" Content="{DynamicResource 'UI:Миниатюры Проводника'}"
                                              AutomationProperties.HelpText="{DynamicResource 'UI:Эскизы файлов. Проводник создаст их снова.'}" />
                                    <CheckBox x:Name="CleanIcons" Content="{DynamicResource 'UI:Кэш иконок'}"
                                              AutomationProperties.HelpText="{DynamicResource 'UI:Сохранённые значки. Проводник создаст их снова.'}" />
                                    <CheckBox x:Name="CleanDirectX" Content="{DynamicResource 'UI:Кэш шейдеров DirectX'}"
                                              AutomationProperties.HelpText="{DynamicResource 'UI:Кэш графики DirectX. Первый запуск игр может замедлиться.'}" />
                                    <CheckBox x:Name="CleanNvidia" Content="{DynamicResource 'UI:Кэш шейдеров NVIDIA'}"
                                              AutomationProperties.HelpText="{DynamicResource 'UI:Кэш графики NVIDIA. Первый запуск игр может замедлиться.'}" />
                                    <CheckBox x:Name="CleanWerArchive" Content="{DynamicResource 'UI:Архив отчётов Windows'}"
                                              AutomationProperties.HelpText="{DynamicResource 'UI:Сохранённые отчёты о сбоях старше 30 дней.'}" />
                                    <CheckBox x:Name="CleanWerQueue" Content="{DynamicResource 'UI:Очередь отчётов Windows'}"
                                              AutomationProperties.HelpText="{DynamicResource 'UI:Отчёты старше 30 дней. Неотправленные будут потеряны.'}" />
                                    <CheckBox x:Name="CleanFontCache" Content="{DynamicResource 'UI:Кэш шрифтов'}"
                                              AutomationProperties.HelpText="{DynamicResource 'UI:Для проблем со шрифтами. Могут понадобиться права администратора.'}" />
                                </UniformGrid>
                                <WrapPanel>
                                    <Button x:Name="ScanButton" Content="{DynamicResource 'UI:Сканировать'}" Style="{StaticResource PrimaryButton}" Click="ScanClick" Margin="0,0,8,6" />
                                    <Button x:Name="DeleteButton" Content="{DynamicResource 'UI:Удалить найденное'}" IsEnabled="False" Click="DeleteClick" />
                                </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource 'UI:Предпросмотр очистки'}" />
                                <TextBlock x:Name="CleanStatus" Style="{StaticResource SecondaryText}" Margin="0,13,0,0"
                                           Text="{DynamicResource 'UI:Запустите сканирование, чтобы увидеть список файлов.'}" AutomationProperties.LiveSetting="Polite" />
                                <ItemsControl x:Name="CleanDetails">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,10,0,0">
                                                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Roots}" Style="{StaticResource SecondaryText}" />
                                                <TextBlock Text="{Binding Skipped}" Style="{StaticResource SecondaryText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ListBox x:Name="CleanItems" Visibility="Collapsed" Height="290" Margin="0,13,0,0"
                                         Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.VirtualizationMode="Recycling"
                                         AutomationProperties.Name="{DynamicResource 'UI:Файлы, доступные для очистки'}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Size}" Style="{StaticResource SecondaryText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                        </Grid>
                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource 'UI:Файлы обновлений Windows'}" />
