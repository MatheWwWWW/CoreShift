                                        <ComboBoxItem Content="{DynamicResource 'UI:Только обязательные'}" />
                                        <ComboBoxItem Content="{DynamicResource 'UI:Обязательные и необязательные'}" />
                                    </ComboBox>
                                    <Button x:Name="DiagnosticApplyButton" Content="{DynamicResource 'UI:Применить'}" Click="ChangeDiagnosticClick"
