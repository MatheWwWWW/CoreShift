<Window x:Class="CoreShift.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CoreShift" Width="1220" Height="790" MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Canvas}"
        Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" Loaded="OnLoaded" Closing="OnClosing" StateChanged="OnWindowStateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid x:Name="WindowSurface" Background="{StaticResource Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="20,0">
                    <Border Width="27" Height="27" CornerRadius="7" Background="{StaticResource Accent}" VerticalAlignment="Center">
                        <Path Data="M 10,1 L 3,9 H 8 L 6,16 L 14,7 H 9 Z"
                              Fill="#151B10" Width="13" Height="16" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="CoreShift" FontWeight="Bold" FontSize="17" VerticalAlignment="Center" Margin="9,0,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleButton}" ToolTip="Свернуть" AutomationProperties.Name="Свернуть" Click="MinimizeClick">
                        <Path Data="M 0,5 H 10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleButton}" ToolTip="Развернуть"
                            AutomationProperties.Name="Развернуть" Click="MaximizeClick">
                        <Path x:Name="MaximizeGlyph" Data="M 0,0 H 9 V 9 H 0 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource CloseTitleButton}" ToolTip="Закрыть" AutomationProperties.Name="Закрыть" Click="CloseClick">
                        <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="204" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel Margin="15,23,15,20">
                    <Border DockPanel.Dock="Bottom" Background="#1B1D25" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="10" Padding="11,10">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Violet}" Margin="0,6,9,0" VerticalAlignment="Top" />
                            <StackPanel>
                                <TextBlock Text="Доступ Windows" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock x:Name="AccessMode" Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel>
                        <RadioButton x:Name="OverviewNav" Content="Обзор" Tag="{StaticResource OverviewIcon}"
                                     GroupName="Navigation" IsChecked="True" Style="{StaticResource NavButton}" Checked="Navigate" />
                        <RadioButton x:Name="PcInfoNav" Content="О компьютере" Tag="{StaticResource PcInfoIcon}"
                                     GroupName="Navigation" Style="{StaticResource NavButton}" Checked="Navigate" />
                        <RadioButton x:Name="MemoryNav" Content="Память" Tag="{StaticResource MemoryIcon}"
                                     GroupName="Navigation" Style="{StaticResource NavButton}" Checked="Navigate" />
                        <RadioButton x:Name="CleanNav" Content="Очистка" Tag="{StaticResource CleanIcon}"
                                     GroupName="Navigation" Style="{StaticResource NavButton}" Checked="Navigate" />
                        <RadioButton x:Name="TweaksNav" Content="Твики Windows" Tag="{StaticResource TweaksIcon}"
                                     GroupName="Navigation" Style="{StaticResource NavButton}" Checked="Navigate" />
                        <RadioButton x:Name="ProfileNav" Content="Профиль фокуса" Tag="{StaticResource FocusIcon}"
                                     GroupName="Navigation" Style="{StaticResource NavButton}" Checked="Navigate" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="PageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="30,23,30,26">
                    <StackPanel x:Name="OverviewPage">
                        <DockPanel LastChildFill="True" Margin="0,0,0,17">
                            <Button x:Name="RefreshButton" DockPanel.Dock="Right" VerticalAlignment="Center"
                                    Margin="12,0,0,0" Click="RefreshClick" AutomationProperties.Name="Обновить диагностику">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource RefreshIcon}" Stroke="{StaticResource Accent}" StrokeThickness="1.5"
                                          Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock Text="Обновить" />
                                </StackPanel>
                            </Button>
                            <StackPanel>
                                <TextBlock Style="{StaticResource PageTitle}" Text="Обзор системы" />
                                <TextBlock x:Name="RefreshStatus" Style="{StaticResource SecondaryText}" Margin="0,4,0,0"
                                           Text="Получаем данные Windows…" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource Card}" Padding="0" MinHeight="219">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#182322" Offset="0" />
                                    <GradientStop Color="#1B2429" Offset=".51" />
                                    <GradientStop Color="#212035" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="248" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="23,20,8,20" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource MemoryIcon}" Stroke="{StaticResource Accent}" Width="17" Height="17"
                                              StrokeThickness="1.4" Stretch="Uniform" Margin="0,0,8,0" />
                                        <TextBlock Text="Оперативная память" Style="{StaticResource SectionTitle}" />
                                    </StackPanel>
                                    <TextBlock x:Name="RamPercent" Text="—" FontFamily="Cascadia Mono, Consolas"
                                               Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="53" Margin="-3,0,0,2" />
                                    <TextBlock x:Name="RamUsage" Text="Чтение показателей памяти" Foreground="{StaticResource Text}" FontSize="14" />
                                    <TextBlock x:Name="RamAvailable" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="0,13,13,0">
                                    <Border.Background>
                                        <DrawingBrush TileMode="Tile" Viewport="0,0,19,19" ViewportUnits="Absolute"
                                                      Viewbox="0,0,19,19" ViewboxUnits="Absolute">
                                            <DrawingBrush.Drawing>
                                                <GeometryDrawing Brush="#22BCB1EF" Geometry="M 1,0 A 1,1 0 1 1 0,1 A 1,1 0 0 1 1,0" />
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Border.Background>
                                    <Grid Width="170" Height="170" IsHitTestVisible="False">
                                        <Ellipse Stroke="#596075" StrokeThickness="1" StrokeDashArray="1 4" />
                                        <Ellipse Margin="11" Stroke="#383D4E" StrokeThickness="8" />
                                        <Path x:Name="RamGauge" Stroke="{StaticResource Accent}" StrokeThickness="8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <Ellipse Margin="27" Stroke="#45495B" StrokeThickness="1" />
                                        <Border Width="60" Height="60" Background="#30343E" CornerRadius="16">
                                            <Path Data="{StaticResource MemoryIcon}" Stroke="{StaticResource Accent}" StrokeThickness="1.35"
                                                  Width="29" Height="29" Stretch="Uniform" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Margin="0,14,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Padding="16,13">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="Пик выделенной памяти" />
                                    <TextBlock x:Name="CommitPeak" Text="—" Style="{StaticResource MetricValue}" Margin="0,6,0,2" />
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="С последней загрузки" FontSize="11" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,13">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="Лимит выделения" />
                                    <TextBlock x:Name="CommitLimit" Text="—" Style="{StaticResource MetricValue}" Margin="0,6,0,2" />
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="Текущий лимит Windows" FontSize="11" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16,13">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="Файл подкачки" />
                                    <TextBlock x:Name="PagefileCurrent" Text="—" Style="{StaticResource MetricValue}" Margin="0,6,0,2" />
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="Используется сейчас" FontSize="11" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Padding="16">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Файлы подкачки" />
                                    <TextBlock x:Name="PagefileDetail" Style="{StaticResource SecondaryText}" Margin="0,9,0,0"
                                               Text="Получаем список файлов…" />
                                    <ItemsControl x:Name="PagefileItems" Margin="0,9,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,8,0,2">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Usage}" Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Быстрые действия" />
                                    <Button Margin="0,9,0,6" Click="OpenCleanClick" HorizontalContentAlignment="Stretch">
                                        <DockPanel>
                                            <Path DockPanel.Dock="Right" Data="{StaticResource ArrowIcon}" Stroke="{StaticResource Accent}"
                                                  StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Margin="12,0,0,0" />
                                            <TextBlock Text="Открыть очистку" />
                                        </DockPanel>
                                    </Button>
                                    <Button Click="OpenProfileClick" HorizontalContentAlignment="Stretch">
                                        <DockPanel>
                                            <Path DockPanel.Dock="Right" Data="{StaticResource ArrowIcon}" Stroke="{StaticResource Violet}"
                                                  StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Margin="12,0,0,0" />
                                            <TextBlock Text="Открыть профиль фокуса" />
                                        </DockPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="PcInfoPage" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="О компьютере" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="Сведения о Windows и оборудовании." Margin="0,4,0,17" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="PcInfoStatus" Style="{StaticResource SecondaryText}"
                                           Text="Получаем сведения о компьютере…" AutomationProperties.LiveSetting="Polite" />
                                <ItemsControl x:Name="PcInfoItems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Label}" Margin="0,0,14,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="MemoryPage" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Память" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="Диагностика файла подкачки и рабочий набор процессов." Margin="0,4,0,17" />
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Настройка файла подкачки" />
                                <TextBlock Text="Рекомендация: оставьте управление размером файла подкачки Windows." TextWrapping="Wrap" Margin="0,10,0,0" />
                                <TextBlock x:Name="MemoryAdvice" Style="{StaticResource SecondaryText}" Margin="0,9,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Сбросить рабочий набор процесса" />
                                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,15"
                                           Text="Укажите PID из Диспетчера задач. Процесс сможет снова загрузить страницы памяти по мере необходимости." />
                                <Label Content="PID процесса" Target="{Binding ElementName=TrimPid}" Foreground="{StaticResource Text}" Padding="0,0,0,5" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="TrimPid" Width="140" MaxLength="10" Margin="0,0,8,0" />
                                    <Button x:Name="TrimButton" Content="Сбросить" Style="{StaticResource PrimaryButton}" Click="TrimClick" />
                                </StackPanel>
                                <TextBlock x:Name="TrimStatus" Style="{StaticResource SecondaryText}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="CleanPage" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Очистка Temp" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="Просмотр временных файлов старше 24 часов перед удалением." Margin="0,4,0,17" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <WrapPanel x:Name="CleanCategoryChoices">
                                    <CheckBox x:Name="CleanTemp" Content="Папки Temp (пользовательская и системная)" IsChecked="True"
                                              Foreground="{StaticResource Text}" Margin="0,0,16,8" />
                                    <CheckBox x:Name="CleanThumbnails" Content="Миниатюры Проводника"
                                              Foreground="{StaticResource Text}" Margin="0,0,16,8" />
                                    <CheckBox x:Name="CleanIcons" Content="Кэш иконок"
                                              Foreground="{StaticResource Text}" Margin="0,0,0,8" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,0,0,12"
                                           Text="Windows восстановит кэш Проводника по мере необходимости. Занятые файлы пропускаются." />
                                <WrapPanel>
                                    <Button x:Name="ScanButton" Content="Сканировать" Style="{StaticResource PrimaryButton}" Click="ScanClick" Margin="0,0,8,0" />
                                    <Button x:Name="DeleteButton" Content="Удалить найденное" IsEnabled="False" Click="DeleteClick" />
                                </WrapPanel>
                                <TextBlock x:Name="CleanStatus" Style="{StaticResource SecondaryText}" Margin="0,13,0,0"
                                           Text="Запустите сканирование, чтобы увидеть список файлов." AutomationProperties.LiveSetting="Polite" />
                                <ItemsControl x:Name="CleanDetails">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,10,0,0">
                                                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Roots}" Style="{StaticResource SecondaryText}" />
                                                <TextBlock Text="{Binding Skipped}" Style="{StaticResource SecondaryText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ListBox x:Name="CleanItems" Visibility="Collapsed" Height="290" Margin="0,13,0,0"
                                         Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.VirtualizationMode="Recycling"
                                         AutomationProperties.Name="Файлы, доступные для очистки">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Size}" Style="{StaticResource SecondaryText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="TweaksPage" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Твики Windows" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="Настройка системных политик с восстановлением исходных значений." Margin="0,4,0,17" />
                        <TextBlock x:Name="TweaksStatus" Style="{StaticResource SecondaryText}" Margin="0,0,0,10"
                                   Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                        <ItemsControl x:Name="TweakItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding State}" Foreground="{StaticResource Violet}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" Margin="0,5,0,0" />
                                            <TextBlock Text="{Binding Risk}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                                            <WrapPanel Margin="0,10,0,0">
                                                <Button Content="Применить" Tag="{Binding}" IsEnabled="{Binding CanApply}"
                                                        Style="{StaticResource PrimaryButton}" Click="ApplyTweakClick" Margin="0,0,8,0" />
                                                <Button Content="Восстановить" Tag="{Binding}" IsEnabled="{Binding CanRestore}" Click="RestoreTweakClick" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="ProfilePage" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Профиль фокуса" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="Временный приоритет выбранного приложения, пока его окно в фокусе." Margin="0,4,0,17" />
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Приложение и приоритет" />
                                <Label Content="Открытое приложение" Target="{Binding ElementName=ProfileApplication}"
                                       Foreground="{StaticResource Text}" Padding="0" Margin="0,14,0,6" />
                                <Grid HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="350" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ProfileApplication" Style="{StaticResource ProfileApplicationPicker}"
                                              IsEnabled="False" SelectionChanged="ProfileApplicationChanged" TextSearch.TextPath="Label">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button x:Name="RefreshProfileApplicationsButton" Grid.Column="1" Content="Обновить"
                                            AutomationProperties.Name="Обновить список открытых приложений"
                                            Click="RefreshProfileApplicationsClick" Margin="8,0,0,0" />
                                </Grid>
                                <TextBlock x:Name="ProfileApplicationStatus" Style="{StaticResource SecondaryText}"
                                           Visibility="Collapsed" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Text="Приоритет в фокусе" Margin="0,14,0,6" />
                                <WrapPanel x:Name="PriorityChoices" Margin="0,0,0,8">
                                    <RadioButton x:Name="AbovePriority" Content="Выше обычного" Style="{StaticResource ChoiceButton}" GroupName="Priority" IsChecked="True" />
                                    <RadioButton x:Name="NormalPriority" Content="Обычный" Style="{StaticResource ChoiceButton}" GroupName="Priority" />
                                    <RadioButton Content="Ниже обычного" Style="{StaticResource ChoiceButton}" GroupName="Priority" />
                                </WrapPanel>
                                <WrapPanel>
                                    <Button x:Name="StartProfileButton" Content="Запустить профиль" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="StartProfileClick" Margin="0,0,8,0" />
                                    <Button x:Name="StopProfileButton" Content="Остановить" IsEnabled="False" Click="StopProfileClick" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Состояние профиля" />
                                <TextBlock x:Name="ProfileStatus" Style="{StaticResource SecondaryText}" Text="Профиль остановлен."
                                           Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
                                <ItemsControl x:Name="ProfileEvents" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource SecondaryText}" Margin="0,5,0,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
