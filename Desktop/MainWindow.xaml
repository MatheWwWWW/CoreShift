                    <Button Content="{DynamicResource 'UI:Создать точку восстановления'}" Click="RunMaintenanceClick" Tag="restore-point" Margin="0,0,7,7"  />
                    <Button Content="{DynamicResource 'UI:Защита системы'}" Click="OpenWindowsUtilityClick" Tag="SystemPropertiesProtection.exe" Margin="0,0,7,7"  />
                    <Button Content="{DynamicResource 'UI:Восстановление системы'}" Click="OpenWindowsUtilityClick" Tag="rstrui.exe" Margin="0,0,7,7"  />
                    </WrapPanel>
                    </StackPanel></Border></StackPanel></TabItem>
                    </TabControl>
