                                        <Button Content="{DynamicResource 'UI:Отключить гибернацию'}" Click="RunMaintenanceClick" Tag="hibernate-off" Margin="0,0,8,4" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16">
                            <StackPanel>
