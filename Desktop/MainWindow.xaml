<Window x:Class="CoreShift.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CoreShift" Width="1220" Height="790" MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Canvas}"
        Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" Loaded="OnLoaded" Closing="OnClosing" StateChanged="OnWindowStateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate x:Key="WindowsTweakCard">
            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding State}" Foreground="{StaticResource Violet}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" Margin="0,5,0,0" />
                    <TextBlock Text="{Binding Risk}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="Применить" Tag="{Binding}" IsEnabled="{Binding CanApply}"
                                Style="{StaticResource PrimaryButton}" Click="ApplyTweakClick" Margin="0,0,8,0" />
                        <Button Content="Восстановить" Tag="{Binding}" IsEnabled="{Binding CanRestore}" Click="RestoreTweakClick" />
                        <Button Content="Параметры пользователя" Tag="{Binding SettingsUri}" Click="OpenTweakSettingsClick" Margin="8,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SettingsUri}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid x:Name="WindowSurface" Background="{StaticResource Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="20,0">
                    <Border Width="27" Height="27" CornerRadius="7" Background="{StaticResource Accent}" VerticalAlignment="Center">
                        <Path Data="M 10,1 L 3,9 H 8 L 6,16 L 14,7 H 9 Z"
                              Fill="#151B10" Width="13" Height="16" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="CoreShift" FontWeight="Bold" FontSize="17" VerticalAlignment="Center" Margin="9,0,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleButton}" ToolTip="Свернуть" AutomationProperties.Name="Свернуть" Click="MinimizeClick">
                        <Path Data="M 0,5 H 10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleButton}" ToolTip="Развернуть"
                            AutomationProperties.Name="Развернуть" Click="MaximizeClick">
                        <Path x:Name="MaximizeGlyph" Data="M 0,0 H 9 V 9 H 0 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource CloseTitleButton}" ToolTip="Свернуть в трей"
                            AutomationProperties.Name="Свернуть в трей" Click="CloseClick">
                        <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border x:Name="UpdateBanner" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Accent}" BorderThickness="0,0,0,1" Padding="20,10">
            <DockPanel>
                <Button x:Name="InstallUpdateButton" DockPanel.Dock="Right" Content="Установить"
                        Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Margin="16,0,0,0"
                        Click="InstallUpdateClick" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Вышла новая версия приложения" FontWeight="SemiBold" />
                    <TextBlock x:Name="UpdateStatus" Style="{StaticResource SecondaryText}" Margin="0,3,0,0"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="204" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel Margin="15,23,15,20">
                    <Border DockPanel.Dock="Bottom" Background="#1B1D25" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="10" Padding="11,10">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Violet}" Margin="0,6,9,0" VerticalAlignment="Top" />
                            <StackPanel>
                                <TextBlock Text="Доступ Windows" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock x:Name="AccessMode" Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel>
                        <RadioButton x:Name="OverviewNav" Content="Обзор" Tag="{StaticResource OverviewIcon}"
                                     GroupName="Navigation" IsChecked="True" Style="{StaticResource NavButton}" Checked="Navigate" />
                        <RadioButton x:Name="PcInfoNav" Content="О компьютере" Tag="{StaticResource PcInfoIcon}"
                                     GroupName="Navigation" Style="{StaticResource NavButton}" Checked="Navigate" />
                        <RadioButton x:Name="MemoryNav" Content="Память" Tag="{StaticResource MemoryIcon}"
                                     GroupName="Navigation" Style="{StaticResource NavButton}" Checked="Navigate" />
                        <RadioButton x:Name="CleanNav" Content="Очистка" Tag="{StaticResource CleanIcon}"
                                     GroupName="Navigation" Style="{StaticResource NavButton}" Checked="Navigate" />
                        <RadioButton x:Name="TweaksNav" Content="Оптимизация" Tag="{StaticResource TweaksIcon}"
                                     GroupName="Navigation" Style="{StaticResource NavButton}" Checked="Navigate" />
                        <RadioButton x:Name="PrivacyNav" Content="Персонализация" Tag="{StaticResource PrivacyIcon}" ToolTip="Персонализация и приватность"
                                     GroupName="Navigation" Style="{StaticResource NavButton}" Checked="Navigate" />
                        <RadioButton x:Name="ProfileNav" Content="Профиль фокуса" Tag="{StaticResource FocusIcon}"
                                     GroupName="Navigation" Style="{StaticResource NavButton}" Checked="Navigate" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="PageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="30,23,30,26">
                    <StackPanel x:Name="OverviewPage">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Обзор системы" />
                        <TextBlock x:Name="RefreshStatus" Style="{StaticResource SecondaryText}" Margin="0,4,0,17"
                                   Text="Получаем данные Windows…" />

                        <Border Style="{StaticResource Card}" Padding="0" MinHeight="219">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#182322" Offset="0" />
                                    <GradientStop Color="#1B2429" Offset=".51" />
                                    <GradientStop Color="#212035" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="248" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="23,20,8,20" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource MemoryIcon}" Stroke="{StaticResource Accent}" Width="17" Height="17"
                                              StrokeThickness="1.4" Stretch="Uniform" Margin="0,0,8,0" />
                                        <TextBlock Text="Оперативная память" Style="{StaticResource SectionTitle}" />
                                    </StackPanel>
                                    <TextBlock x:Name="RamPercent" Text="—" FontFamily="Cascadia Mono, Consolas"
                                               Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="53" Margin="-3,0,0,2" />
                                    <TextBlock x:Name="RamUsage" Text="Чтение показателей памяти" Foreground="{StaticResource Text}" FontSize="14" />
                                    <TextBlock x:Name="RamAvailable" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="0,13,13,0">
                                    <Border.Background>
                                        <DrawingBrush TileMode="Tile" Viewport="0,0,19,19" ViewportUnits="Absolute"
                                                      Viewbox="0,0,19,19" ViewboxUnits="Absolute">
                                            <DrawingBrush.Drawing>
                                                <GeometryDrawing Brush="#22BCB1EF" Geometry="M 1,0 A 1,1 0 1 1 0,1 A 1,1 0 0 1 1,0" />
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Border.Background>
                                    <Grid Width="170" Height="170" IsHitTestVisible="False">
                                        <Ellipse Stroke="#596075" StrokeThickness="1" StrokeDashArray="1 4" />
                                        <Ellipse Margin="11" Stroke="#383D4E" StrokeThickness="8" />
                                        <Path x:Name="RamGauge" Stroke="{StaticResource Accent}" StrokeThickness="8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <Ellipse Margin="27" Stroke="#45495B" StrokeThickness="1" />
                                        <Border Width="60" Height="60" Background="#30343E" CornerRadius="16">
                                            <Path Data="{StaticResource MemoryIcon}" Stroke="{StaticResource Accent}" StrokeThickness="1.35"
                                                  Width="29" Height="29" Stretch="Uniform" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Margin="0,14,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Padding="16,13">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="Пик выделенной памяти" />
                                    <TextBlock x:Name="CommitPeak" Text="—" Style="{StaticResource MetricValue}" Margin="0,6,0,2" />
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="С последней загрузки" FontSize="11" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,13">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="Лимит выделения" />
                                    <TextBlock x:Name="CommitLimit" Text="—" Style="{StaticResource MetricValue}" Margin="0,6,0,2" />
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="Текущий лимит Windows" FontSize="11" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16,13">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="Файл подкачки" />
                                    <TextBlock x:Name="PagefileCurrent" Text="—" Style="{StaticResource MetricValue}" Margin="0,6,0,2" />
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="Используется сейчас" FontSize="11" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Padding="16">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Файлы подкачки" />
                                    <TextBlock x:Name="PagefileDetail" Style="{StaticResource SecondaryText}" Margin="0,9,0,0"
                                               Text="Получаем список файлов…" />
                                    <ItemsControl x:Name="PagefileItems" Margin="0,9,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,8,0,2">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Usage}" Style="{StaticResource SecondaryText}" FontSize="11" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Быстрые действия" />
                                    <Button Margin="0,9,0,6" Click="OpenCleanClick" HorizontalContentAlignment="Stretch">
                                        <DockPanel>
                                            <Path DockPanel.Dock="Right" Data="{StaticResource ArrowIcon}" Stroke="{StaticResource Accent}"
                                                  StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Margin="12,0,0,0" />
                                            <TextBlock Text="Открыть очистку" />
                                        </DockPanel>
                                    </Button>
                                    <Button Click="OpenProfileClick" HorizontalContentAlignment="Stretch">
                                        <DockPanel>
                                            <Path DockPanel.Dock="Right" Data="{StaticResource ArrowIcon}" Stroke="{StaticResource Violet}"
                                                  StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Margin="12,0,0,0" />
                                            <TextBlock Text="Открыть профиль фокуса" />
                                        </DockPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="PcInfoPage" Visibility="Collapsed">
                        <DockPanel Margin="0,0,0,17">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button x:Name="PcInfoRefreshButton" Content="Обновить" Click="RefreshPcInfoClick" Margin="0,0,8,0" />
                                <Button x:Name="PcInfoCopyButton" Content="Скопировать отчёт" Click="CopyPcInfoClick" IsEnabled="False" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource PageTitle}" Text="О компьютере" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock x:Name="PcInfoStatus" Style="{StaticResource SecondaryText}" FontSize="14" Margin="0,0,0,12" Visibility="Collapsed"
                                   Text="Получаем сведения о компьютере…" AutomationProperties.LiveSetting="Polite" />
                        <ItemsControl x:Name="PcInfoSummary" Margin="0,0,-12,4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="16,14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource SecondaryText}" FontSize="14" />
                                            <TextBlock Text="{Binding Value}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Detail}" Margin="0,4,0,0" FontSize="14">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl x:Name="PcInfoItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Style="{StaticResource DetailsExpander}" IsExpanded="{Binding Expanded, Mode=TwoWay}" Margin="0,0,0,10">
                                        <Expander.Header>
                                            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" FontSize="18" TextWrapping="Wrap" />
                                        </Expander.Header>
                                        <Border Style="{StaticResource Card}" Padding="16,6">
                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,7">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="205" />
                                                                    <ColumnDefinition />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Label}" FontSize="14" LineHeight="23" Margin="0,0,18,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="16" FontWeight="Medium"
                                                                           LineHeight="23" TextWrapping="Wrap" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="MemoryPage" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Память" Margin="0,0,0,17" />
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="Доступно ОЗУ" />
                                        <TextBlock x:Name="DiagnosticRam" Style="{StaticResource MetricValue}" Text="—" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="Выделено Windows" />
                                        <TextBlock x:Name="DiagnosticCommit" Style="{StaticResource MetricValue}" Text="—" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="Запас до лимита" />
                                        <TextBlock x:Name="DiagnosticHeadroom" Style="{StaticResource MetricValue}" Text="—" TextWrapping="Wrap" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="История за 15 минут" Margin="0,18,0,8" />
                                <WrapPanel Margin="0,0,0,8">
                                    <TextBlock Text="●  Занято ОЗУ" Foreground="{StaticResource Accent}" Margin="0,0,16,0" />
                                    <TextBlock Text="●  Выделено от текущего лимита" Foreground="{StaticResource Violet}" />
                                </WrapPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="106" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="100%" VerticalAlignment="Top" />
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="50%" VerticalAlignment="Center" />
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="0%" VerticalAlignment="Bottom" />
                                    </Grid>
                                    <Grid Grid.Column="1" Background="{StaticResource Canvas}" AutomationProperties.Name="История загрузки памяти">
                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1" />
                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" VerticalAlignment="Center" />
                                        <Canvas x:Name="MemoryHistoryPlot" ClipToBounds="True" SizeChanged="MemoryHistorySizeChanged">
                                            <Path x:Name="RamHistoryLine" Stroke="{StaticResource Accent}" StrokeThickness="2" />
                                            <Path x:Name="CommitHistoryLine" Stroke="{StaticResource Violet}" StrokeThickness="2" StrokeDashArray="3,2" />
                                        </Canvas>
                                        <TextBlock x:Name="MemoryHistoryStatus" Style="{StaticResource SecondaryText}"
                                                   Text="Собираем первые замеры…" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8" />
                                    </Grid>
                                    <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,5,0,0">
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="Сейчас" DockPanel.Dock="Right" />
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="15 минут назад" />
                                    </DockPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Приложения и процессы" />
                                <Grid Margin="0,12,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="224" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <Label Content="Имя процесса или PID" Target="{Binding ElementName=MemoryProcessSearch}"
                                               Foreground="{StaticResource Muted}" Padding="0,0,0,5" />
                                        <TextBox x:Name="MemoryProcessSearch" TextChanged="MemoryProcessSearchChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <Label Content="Сортировка" Target="{Binding ElementName=MemoryProcessSort}"
                                               Foreground="{StaticResource Muted}" Padding="0,0,0,5" />
                                        <ComboBox x:Name="MemoryProcessSort" Style="{StaticResource DarkComboBox}"
                                                  SelectedIndex="0" SelectionChanged="MemoryProcessSortChanged">
                                            <ComboBoxItem Content="По объёму ОЗУ" />
                                            <ComboBoxItem Content="По приросту в ОЗУ" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Background="{StaticResource Canvas}">
                                    <StackPanel Grid.IsSharedSizeScope="True">
                                        <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}"
                                                BorderThickness="0,0,0,1" CornerRadius="7,7,0,0" Padding="12,8,25,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="62" SharedSizeGroup="ProcessIdColumn" />
                                                    <ColumnDefinition Width="98" SharedSizeGroup="WorkingSetColumn" />
                                                    <ColumnDefinition Width="118" SharedSizeGroup="GrowthColumn" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource SecondaryText}" Text="Процесс" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource SecondaryText}" Text="PID" TextAlignment="Right" />
                                                <TextBlock Grid.Column="2" Style="{StaticResource SecondaryText}" Text="В ОЗУ" TextAlignment="Right" />
                                                <TextBlock Grid.Column="3" Style="{StaticResource SecondaryText}" Text="Изм. за 2 мин" TextAlignment="Right" />
                                            </Grid>
                                        </Border>
                                        <Grid>
                                            <ListBox x:Name="MemoryProcesses" MaxHeight="234" MinHeight="44" Background="Transparent"
                                                     BorderThickness="0" Padding="0" Foreground="{StaticResource Text}"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible"
                                                     AutomationProperties.Name="Процессы и использование ОЗУ" SelectionChanged="MemoryProcessSelectionChanged">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                        <Setter Property="Padding" Value="12,7" />
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition />
                                                                <ColumnDefinition SharedSizeGroup="ProcessIdColumn" />
                                                                <ColumnDefinition SharedSizeGroup="WorkingSetColumn" />
                                                                <ColumnDefinition SharedSizeGroup="GrowthColumn" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,8,0" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Pid}" Foreground="{StaticResource Muted}" TextAlignment="Right" />
                                                            <TextBlock Grid.Column="2" Text="{Binding WorkingSet}" FontFamily="Cascadia Mono, Consolas" TextAlignment="Right" />
                                                            <TextBlock Grid.Column="3" Text="{Binding Growth}" FontFamily="Cascadia Mono, Consolas" TextAlignment="Right" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock x:Name="MemoryProcessNoMatches" Text="Процессы не найдены" Visibility="Collapsed"
                                                       Style="{StaticResource SecondaryText}" Margin="12,8"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                                       AutomationProperties.LiveSetting="Polite" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="MemoryProcessStatus" Style="{StaticResource SecondaryText}" Text="Получаем список процессов…" Margin="0,8,0,0" />
                                <Border Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                        CornerRadius="8" Padding="12" Margin="0,12,0,0">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button x:Name="TrimButton" Content="Сбросить рабочий набор" IsEnabled="False" Click="TrimClick"
                                                    DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="MemoryProcessSelection" FontWeight="SemiBold" TextWrapping="Wrap"
                                                           Text="Выберите процесс в таблице" />
                                                <TextBlock x:Name="MemoryProcessActionHint" Style="{StaticResource SecondaryText}"
                                                           Margin="0,3,0,0" Visibility="Collapsed" />
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock x:Name="TrimStatus" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Файл подкачки" />
                                <TextBlock x:Name="PagefileMode" Style="{StaticResource SecondaryText}" Text="Читаем настройки Windows…" Margin="0,6,0,0" />
                                <TextBlock x:Name="DiagnosticPagefileStatus" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" Visibility="Collapsed" />
                                <ItemsControl x:Name="DiagnosticPagefiles">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}"
                                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <UniformGrid Columns="3" Margin="0,9,0,0">
                                                        <StackPanel Margin="0,0,10,0">
                                                            <TextBlock Text="Занято / выделено" Style="{StaticResource SecondaryText}" />
                                                            <TextBlock Text="{Binding Allocation}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,10,0">
                                                            <TextBlock Text="Пик использования" Style="{StaticResource SecondaryText}" />
                                                            <TextBlock Text="{Binding Peak}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="Свободно на диске" Style="{StaticResource SecondaryText}" />
                                                            <TextBlock Text="{Binding FreeSpace}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                        </StackPanel>
                                                    </UniformGrid>
                                                    <ProgressBar Value="{Binding UsagePercent, Mode=OneWay}" Maximum="100" Margin="0,10,0,0"
                                                                 AutomationProperties.Name="Использование выделенного файла подкачки">
                                                        <ProgressBar.Style>
                                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource MemoryUsageMeter}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasUsage}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ProgressBar.Style>
                                                    </ProgressBar>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="MemoryPressureStatus" Style="{StaticResource SecondaryText}" Visibility="Collapsed" Margin="0,8,0,0" />
                                <Expander Header="Оценка размера и системные дампы" Style="{StaticResource DetailsExpander}" Margin="0,12,0,0">
                                    <TextBlock x:Name="MemoryAdvice" Style="{StaticResource SecondaryText}" />
                                </Expander>
                                <DockPanel Margin="0,12,0,0">
                                    <Button Content="Открыть параметры системы" Click="OpenPagefileSettingsClick" Margin="0,0,12,0" />
                                    <TextBlock Style="{StaticResource SecondaryText}" VerticalAlignment="Center"
                                               Text="Быстродействие → Параметры → Дополнительно → Виртуальная память" />
                                </DockPanel>
                                <TextBlock x:Name="PagefileSettingsStatus" Style="{StaticResource SecondaryText}" Visibility="Collapsed" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="CleanPage" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Очистка Temp" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="Перед удалением вы увидите список файлов. Занятые файлы пропускаются." Margin="0,4,0,17" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <UniformGrid x:Name="CleanCategoryChoices" Columns="2" Margin="-4,-4,-4,12">
                                    <UniformGrid.Resources>
                                        <Style TargetType="CheckBox" BasedOn="{StaticResource CleanupOption}" />
                                    </UniformGrid.Resources>
                                    <CheckBox x:Name="CleanTemp" Content="Папки Temp" IsChecked="True"
                                              AutomationProperties.HelpText="Временные файлы Windows и приложений старше суток." />
                                    <CheckBox x:Name="CleanThumbnails" Content="Миниатюры Проводника"
                                              AutomationProperties.HelpText="Эскизы файлов. Проводник создаст их снова." />
                                    <CheckBox x:Name="CleanIcons" Content="Кэш иконок"
                                              AutomationProperties.HelpText="Сохранённые значки. Проводник создаст их снова." />
                                    <CheckBox x:Name="CleanDirectX" Content="Кэш шейдеров DirectX"
                                              AutomationProperties.HelpText="Кэш графики DirectX. Первый запуск игр может замедлиться." />
                                    <CheckBox x:Name="CleanNvidia" Content="Кэш шейдеров NVIDIA"
                                              AutomationProperties.HelpText="Кэш графики NVIDIA. Первый запуск игр может замедлиться." />
                                    <CheckBox x:Name="CleanWerArchive" Content="Архив отчётов Windows"
                                              AutomationProperties.HelpText="Сохранённые отчёты о сбоях старше 30 дней." />
                                    <CheckBox x:Name="CleanWerQueue" Content="Очередь отчётов Windows"
                                              AutomationProperties.HelpText="Отчёты старше 30 дней. Неотправленные будут потеряны." />
                                    <CheckBox x:Name="CleanFontCache" Content="Кэш шрифтов"
                                              AutomationProperties.HelpText="Для проблем со шрифтами. Могут понадобиться права администратора." />
                                </UniformGrid>
                                <WrapPanel>
                                    <Button x:Name="ScanButton" Content="Сканировать" Style="{StaticResource PrimaryButton}" Click="ScanClick" Margin="0,0,8,0" />
                                    <Button x:Name="DeleteButton" Content="Удалить найденное" IsEnabled="False" Click="DeleteClick" />
                                </WrapPanel>
                                <TextBlock x:Name="CleanStatus" Style="{StaticResource SecondaryText}" Margin="0,13,0,0"
                                           Text="Запустите сканирование, чтобы увидеть список файлов." AutomationProperties.LiveSetting="Polite" />
                                <ItemsControl x:Name="CleanDetails">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,10,0,0">
                                                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Roots}" Style="{StaticResource SecondaryText}" />
                                                <TextBlock Text="{Binding Skipped}" Style="{StaticResource SecondaryText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ListBox x:Name="CleanItems" Visibility="Collapsed" Height="290" Margin="0,13,0,0"
                                         Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.VirtualizationMode="Recycling"
                                         AutomationProperties.Name="Файлы, доступные для очистки">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Size}" Style="{StaticResource SecondaryText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Файлы обновлений Windows" />
                                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,12"
                                           Text="В параметрах хранилища откройте «Временные файлы» и выберите «Очистка обновлений Windows», если она доступна. Windows сама определяет, какие файлы обновлений можно удалить." />
                                <Button Content="Открыть параметры хранилища" HorizontalAlignment="Left" Click="OpenWindowsStorageClick" />
                                <TextBlock x:Name="WindowsStorageStatus" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"
                                           Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="TweaksPage" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Производительность" Margin="0,0,0,17" />
                        <TextBlock x:Name="PerformanceSettingsStatus" Style="{StaticResource SecondaryText}" Visibility="Collapsed"
                                   Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite" />
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Лимит фоновой загрузки обновлений" />
                                <TextBlock x:Name="DownloadLimitState" Foreground="{StaticResource Violet}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,5,0,0"
                                           Text="Освобождает часть интернет-канала для игр и звонков. Обновления могут скачиваться дольше. Лимит действует на загрузки через оптимизацию доставки, кроме загрузок от устройств в локальной сети." />
                                <WrapPanel Margin="0,10,0,0">
                                    <Label Content="Лимит, % (1–100)" Target="{Binding ElementName=DownloadLimitValue}"
                                           Foreground="{StaticResource Text}" Padding="0" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="DownloadLimitValue" Text="20" Width="62" MaxLength="3" IsEnabled="False"
                                             VerticalContentAlignment="Center" Margin="0,0,8,0" />
                                    <Button x:Name="ApplyDownloadLimitButton" Content="Применить" Style="{StaticResource PrimaryButton}"
                                            IsEnabled="False" Click="ApplyDownloadLimitClick" Margin="0,0,8,0" />
                                    <Button x:Name="RestoreDownloadLimitButton" Content="Восстановить" IsEnabled="False" Click="RestoreDownloadLimitClick" />
                                    <Button Content="Параметры Windows" Tag="ms-settings:delivery-optimization-advanced"
                                            Click="OpenPerformanceSettingsClick" Margin="8,0,0,0" />
                                </WrapPanel>
                                <TextBlock x:Name="DownloadLimitStatus" Style="{StaticResource SecondaryText}" Visibility="Collapsed"
                                           Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Приложения в автозагрузке" />
                                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,5,0,0"
                                           Text="В разделе «Автозагрузка приложений» Диспетчера задач видна оценка влияния на запуск. Там же можно отключить автозапуск выбранного приложения и позже включить его снова." />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="Открыть автозагрузку Windows" Click="OpenPerformanceSettingsClick" Tag="ms-settings:startupapps" Margin="0,0,8,0" />
                                    <Button Content="Диспетчер задач" Click="OpenStartupImpactClick" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Оптимизация оконных игр" />
                                <TextBlock x:Name="WindowedGamesHelp" Style="{StaticResource SecondaryText}" Margin="0,5,0,0"
                                           Text="Снижает задержку вывода кадра в совместимых играх DirectX 10 и 11 в оконном режиме и в окне без рамки. Включите оптимизацию в настройках графики и перезапустите игру." />
                                <Button x:Name="WindowedGamesButton" Content="Открыть настройки графики Windows"
                                        Tag="ms-settings:display-advancedgraphics" Click="OpenPerformanceSettingsClick" HorizontalAlignment="Left" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Исключения из индексации" />
                                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,5,0,0"
                                           Text="Исключите папки с часто меняющимися файлами, например кэшем или результатами сборки. Поиск по этим папкам может стать медленнее. Уже настроенные правила для вложенных папок сохраняются." />
                                <ListBox x:Name="IndexExclusionsList" MaxHeight="140" Margin="0,10,0,0" Visibility="Collapsed"
                                         SelectionChanged="IndexExclusionSelectionChanged" AutomationProperties.Name="Исключения из индексации, добавленные CoreShift" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="AddIndexExclusionButton" Content="Исключить папку…" Click="AddIndexExclusionClick" IsEnabled="False" Margin="0,0,8,0" />
                                    <Button x:Name="RestoreIndexExclusionButton" Content="Восстановить индексацию" Click="RestoreIndexExclusionClick" IsEnabled="False" Margin="0,0,8,0" />
                                    <Button Content="Открыть параметры поиска" Click="OpenPerformanceSettingsClick" Tag="ms-settings:search" />
                                </WrapPanel>
                                <TextBlock x:Name="IndexExclusionStatus" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Временный план питания для игры" />
                                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,5,0,0"
                                           Text="Профиль фокуса может переключить Windows на план «Высокая производительность» после первого перехода в игру. Исходный план возвращается после закрытия игры, отключения питания от сети или остановки профиля." />
                                <Button Content="Открыть профиль фокуса" Click="OpenProfileClick" HorizontalAlignment="Left" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="TweaksStatus" Style="{StaticResource SecondaryText}" Margin="0,0,0,10"
                                   Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                        <ItemsControl x:Name="TweakItems" ItemTemplate="{StaticResource WindowsTweakCard}" />
                    </StackPanel>

                    <StackPanel x:Name="PrivacyPage" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Персонализация и приватность" Margin="0,0,0,17" />
                        <TextBlock x:Name="PrivacyStatus" Style="{StaticResource SecondaryText}" Margin="0,0,0,10"
                                   Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                        <ItemsControl x:Name="PrivacyItems" ItemTemplate="{StaticResource WindowsTweakCard}" />
                    </StackPanel>

                    <StackPanel x:Name="ProfilePage" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Профиль фокуса" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="Временный приоритет приложения и план питания на время игры. Профиль останавливается при выходе из выбранного приложения." Margin="0,4,0,17" />
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Приложение и приоритет" />
                                <Label Content="Открытое приложение" Target="{Binding ElementName=ProfileApplication}"
                                       Foreground="{StaticResource Text}" Padding="0" Margin="0,14,0,6" />
                                <Grid HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="350" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ProfileApplication" Style="{StaticResource DarkComboBox}" Tag="Выберите приложение"
                                              IsEnabled="False" SelectionChanged="ProfileApplicationChanged" TextSearch.TextPath="Label">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button x:Name="RefreshProfileApplicationsButton" Grid.Column="1" Content="Обновить"
                                            AutomationProperties.Name="Обновить список открытых приложений"
                                            Click="RefreshProfileApplicationsClick" Margin="8,0,0,0" />
                                </Grid>
                                <TextBlock x:Name="ProfileApplicationStatus" Style="{StaticResource SecondaryText}"
                                           Visibility="Collapsed" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Text="Приоритет в фокусе" Margin="0,14,0,6" />
                                <WrapPanel x:Name="PriorityChoices" Margin="0,0,0,8">
                                    <RadioButton x:Name="AbovePriority" Content="Выше обычного" Style="{StaticResource ChoiceButton}" GroupName="Priority" IsChecked="True" />
                                    <RadioButton x:Name="NormalPriority" Content="Обычный" Style="{StaticResource ChoiceButton}" GroupName="Priority" />
                                    <RadioButton Content="Ниже обычного" Style="{StaticResource ChoiceButton}" GroupName="Priority" />
                                </WrapPanel>
                                <CheckBox x:Name="ProfileGamePower" Style="{StaticResource CleanupOption}" Margin="0,5,0,6"
                                          Content="Включать план «Высокая производительность» для выбранного приложения" />
                                <TextBlock x:Name="ProfilePowerStatus" Style="{StaticResource SecondaryText}" Margin="0,0,0,12"
                                           Text="Только при питании от сети. Может увеличить энергопотребление и нагрев." />
                                <WrapPanel>
                                    <Button x:Name="StartProfileButton" Content="Запустить профиль" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="StartProfileClick" Margin="0,0,8,0" />
                                    <Button x:Name="StopProfileButton" Content="Остановить" IsEnabled="False" Click="StopProfileClick" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Состояние профиля" />
                                <TextBlock x:Name="ProfileStatus" Style="{StaticResource SecondaryText}" Text="Профиль остановлен."
                                           Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
                                <Border Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                        CornerRadius="8" Padding="12" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Память за сеанс" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock x:Name="MemorySessionStatus" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" />
                                        <TextBlock x:Name="MemorySessionPeak" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" />
                                        <ItemsControl x:Name="MemorySessionProcesses">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <ItemsControl x:Name="ProfileEvents" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource SecondaryText}" Margin="0,5,0,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
