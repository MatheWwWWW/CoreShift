                                </WrapPanel>
                                <TextBlock x:Name="PagefileTweakStatus" Style="{StaticResource SecondaryText}" Visibility="Collapsed"
                                           Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
