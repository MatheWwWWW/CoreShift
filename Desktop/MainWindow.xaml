                                <TextBlock x:Name="WindowedGamesHelp" Style="{StaticResource SecondaryText}" Margin="0,5,0,0"
                                           Text="{DynamicResource 'UI:Снижает задержку вывода кадра в совместимых играх DirectX 10 и 11 в оконном режиме и в окне без рамки. Включите оптимизацию в настройках графики и перезапустите игру.'}" />
                                <Button x:Name="WindowedGamesButton" Content="{DynamicResource 'UI:Открыть настройки графики Windows'}"
                                        Tag="ms-settings:display-advancedgraphics" Click="OpenPerformanceSettingsClick" HorizontalAlignment="Left" Margin="0,10,0,0" />
