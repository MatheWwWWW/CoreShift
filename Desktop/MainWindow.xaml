                                   Text="{DynamicResource 'UI:Снимите показатели до изменения и после него. CoreShift покажет разницу по памяти, процессам и накопителю.'}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width=".7*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="1.3*" />
                            </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource 'UI:Два замера'}" />
