<Window x:Class="CoreShift.Desktop.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource 'UI:Обновление CoreShift'}" Width="424" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{DynamicResource Canvas}"
        Foreground="{DynamicResource Text}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" UseLayoutRounding="True"
        Loaded="OnLoaded">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <StackPanel x:Name="Surface">
            <Border Background="{DynamicResource Rail}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Height="46">
                <StackPanel Orientation="Horizontal" Margin="18,0">
                    <Border Width="27" Height="27" CornerRadius="8,4,8,4" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                            Background="{DynamicResource Selected}" VerticalAlignment="Center">
                        <Path Data="{StaticResource CoreShiftMark}" Stroke="{DynamicResource Accent}" StrokeThickness="1.4"
                              Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="CoreShift" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <StackPanel Margin="22,19,22,18">
                <TextBlock x:Name="Heading" Text="{DynamicResource 'UI:Обновление CoreShift'}" FontWeight="SemiBold" FontSize="22" />
                <TextBlock x:Name="Stage" Style="{StaticResource SecondaryText}" Margin="0,6,0,15" MinHeight="20"
                           AutomationProperties.LiveSetting="Polite" />
                <ProgressBar x:Name="UpdateProgress" Height="8" Minimum="0" Maximum="100"
                             Foreground="{DynamicResource Accent}" AutomationProperties.Name="{DynamicResource 'UI:Ход обновления'}">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid ClipToBounds="True">
                                <Border x:Name="PART_Track" Background="{DynamicResource Raised}" CornerRadius="4" />
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4"
                                        Background="{TemplateBinding Foreground}" />
                                <Border x:Name="Pulse" Width="96" HorizontalAlignment="Left" CornerRadius="4"
                                        Visibility="Collapsed">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="{DynamicResource AccentClear}" Offset="0" />
                                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0.55" />
                                            <GradientStop Color="{DynamicResource AccentClear}" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.RenderTransform>
                                        <TranslateTransform />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsIndeterminate" Value="True">
                                    <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Pulse" Property="Visibility" Value="Visible" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard x:Name="PulseStoryboard">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="RenderTransform.X"
                                                                 From="-96" To="378" Duration="0:0:1.25" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <RemoveStoryboard BeginStoryboardName="PulseStoryboard" />
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
                <DockPanel Margin="0,13,0,0">
                    <Button x:Name="ActionButton" DockPanel.Dock="Right" Content="{DynamicResource 'UI:Отмена'}" Click="ActionClick"
                            HorizontalAlignment="Right" />
                    <TextBlock x:Name="Percent" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"
                               FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" />
                </DockPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
