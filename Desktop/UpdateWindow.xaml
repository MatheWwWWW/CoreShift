<Window x:Class="CoreShift.Desktop.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Обновление CoreShift" Width="424" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{StaticResource Canvas}"
        Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        Loaded="OnLoaded">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <StackPanel x:Name="Surface">
            <Border Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Height="46">
                <StackPanel Orientation="Horizontal" Margin="18,0">
                    <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource Accent}" VerticalAlignment="Center">
                        <Path Data="M 10,1 L 3,9 H 8 L 6,16 L 14,7 H 9 Z" Fill="#151B10"
                              Width="11" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="CoreShift" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <StackPanel Margin="22,19,22,18">
                <TextBlock x:Name="Heading" Text="Обновление CoreShift" FontWeight="SemiBold" FontSize="22" />
                <TextBlock x:Name="Stage" Style="{StaticResource SecondaryText}" Margin="0,6,0,15" MinHeight="20"
                           AutomationProperties.LiveSetting="Polite" />
                <ProgressBar x:Name="UpdateProgress" Height="8" Minimum="0" Maximum="100"
                             Foreground="{StaticResource Accent}" AutomationProperties.Name="Ход обновления">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid ClipToBounds="True">
                                <Border x:Name="PART_Track" Background="{StaticResource Raised}" CornerRadius="4" />
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4"
                                        Background="{TemplateBinding Foreground}" />
                                <Border x:Name="Pulse" Width="96" HorizontalAlignment="Left" CornerRadius="4"
                                        Visibility="Collapsed">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00C8FA75" Offset="0" />
                                            <GradientStop Color="#C8FA75" Offset="0.55" />
                                            <GradientStop Color="#00C8FA75" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.RenderTransform>
                                        <TranslateTransform />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsIndeterminate" Value="True">
                                    <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Pulse" Property="Visibility" Value="Visible" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard x:Name="PulseStoryboard">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="RenderTransform.X"
                                                                 From="-96" To="378" Duration="0:0:1.25" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <RemoveStoryboard BeginStoryboardName="PulseStoryboard" />
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
                <DockPanel Margin="0,13,0,0">
                    <Button x:Name="ActionButton" DockPanel.Dock="Right" Content="Отмена" Click="ActionClick"
                            HorizontalAlignment="Right" />
                    <TextBlock x:Name="Percent" VerticalAlignment="Center" Foreground="{StaticResource Accent}"
                               FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" />
                </DockPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
