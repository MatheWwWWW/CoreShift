<Window x:Class="CoreShift.Desktop.FocusLiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource 'UI:Замер фокуса'}" Width="350" SizeToContent="Height" ResizeMode="NoResize"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
        Background="{DynamicResource Canvas}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" UseLayoutRounding="True">
    <Border x:Name="FocusLiveSurface" Background="{DynamicResource Canvas}" Padding="15" BorderThickness="1" BorderBrush="{DynamicResource Line}">
    <StackPanel x:Name="FocusLiveContent">
        <DockPanel Margin="0,0,0,12">
            <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center" />
            <TextBlock x:Name="PhaseText" Style="{StaticResource SecondaryText}" />
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="10">
                <StackPanel>
                    <TextBlock Text="{DynamicResource 'UI:Разница по ЦП'}" Style="{StaticResource SecondaryText}" />
                    <TextBlock x:Name="CpuDifference" Style="{StaticResource MetricValue}" Foreground="{DynamicResource Accent}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10">
                <StackPanel>
                    <TextBlock Text="{DynamicResource 'UI:Разница по памяти'}" Style="{StaticResource SecondaryText}" />
                    <TextBlock x:Name="MemoryDifference" Style="{StaticResource MetricValue}" Foreground="{DynamicResource Violet}" />
                </StackPanel>
            </Border>
        </Grid>
        <TextBlock x:Name="CurrentText" Style="{StaticResource SecondaryText}" Margin="0,12,0,0" />
    </StackPanel>
    </Border>
</Window>
