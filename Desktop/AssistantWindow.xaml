<Window x:Class="CoreShift.Desktop.AssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource 'UI:Шифтер'}" Width="760" Height="660" MinWidth="540" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Canvas}"
        AllowDrop="True" DragOver="ImageDragOver" Drop="ImageDrop" PreviewKeyDown="AssistantKeyDown"
        Foreground="{DynamicResource Text}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
    <Grid Margin="19">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,11">
            <TextBlock Text="{DynamicResource 'UI:Шифтер'}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{DynamicResource 'UI:Свободный чат и справка по CoreShift'}" Style="{StaticResource SecondaryText}" Margin="0,3,0,10" />
            <WrapPanel>
                <Button Content="{DynamicResource 'UI:Новый разговор'}" Click="ClearClick" Margin="0,0,0,3" />
                <Button x:Name="CancelButton" Content="{DynamicResource 'UI:Остановить ответ'}" Click="CancelClick" Margin="8,0,0,3" Visibility="Collapsed" />
            </WrapPanel>
            <TextBlock x:Name="Status" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="11">
            <ScrollViewer x:Name="Transcript" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Messages" /></ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,9,0,0">
            <Border x:Name="ImageAttachment" Style="{StaticResource Card}" Padding="8" Margin="0,0,0,8" Visibility="Collapsed">
                <DockPanel>
                    <Image x:Name="ImagePreview" Width="52" Height="42" Margin="0,0,8,0" />
                    <Button DockPanel.Dock="Right" Content="{DynamicResource 'UI:Убрать фото'}" Click="RemoveImageClick" Margin="8,0,0,0" />
                    <TextBlock x:Name="ImageName" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
            <WrapPanel x:Name="Attachments" Visibility="Collapsed">
                <Button x:Name="PhotoButton" Content="{DynamicResource 'UI:Прикрепить фото'}" Click="PhotoClick" Margin="0,0,8,8"
                        ToolTip="{DynamicResource 'UI:Выберите фото или вставьте скриншот через Ctrl+V.'}" />
                <Button x:Name="AttachmentButton" Margin="0,0,0,8" Click="AttachmentClick"
                        ToolTip="{DynamicResource 'UI:Сводка Windows и комплектующих для следующего сообщения локальной модели.'}" />
            </WrapPanel>
            <DockPanel LastChildFill="True">
                <Button x:Name="SubmitButton" DockPanel.Dock="Right" Content="{DynamicResource 'UI:Спросить'}" Style="{StaticResource PrimaryButton}"
                        Click="SubmitClick" Margin="8,0,0,0" IsDefault="True" />
                <TextBox x:Name="Question" MaxLength="1400" VerticalContentAlignment="Center"
                         AutomationProperties.Name="{DynamicResource 'UI:Сообщение Шифтеру'}" />
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
