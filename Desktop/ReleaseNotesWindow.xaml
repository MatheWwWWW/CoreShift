<Window x:Class="CoreShift.Desktop.ReleaseNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Что нового?" Width="620" Height="470" MinWidth="410" MinHeight="300"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ShowInTaskbar="False"
        Background="{StaticResource Canvas}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="46" Background="{StaticResource Rail}"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource CloseTitleButton}" ToolTip="Закрыть"
                            AutomationProperties.Name="Закрыть окно" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseClick">
                        <Path Data="M 0,0 L 9,9 M 9,0 L 0,9"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <StackPanel Orientation="Horizontal" Margin="18,0">
                        <Border Width="24" Height="24" CornerRadius="6" Background="{StaticResource Accent}" VerticalAlignment="Center">
                            <Path Data="M 10,1 L 3,9 H 8 L 6,16 L 14,7 H 9 Z" Fill="#151B10"
                                  Width="11" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Что нового?" FontSize="15" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <DockPanel DockPanel.Dock="Bottom" Margin="22,14,22,18">
                <Button DockPanel.Dock="Right" Content="Закрыть" Style="{StaticResource PrimaryButton}"
                        IsCancel="True" IsDefault="True" Click="CloseClick" />
                <TextBlock x:Name="VersionText" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
            </DockPanel>
            <Border Style="{StaticResource Card}" Margin="22,18,22,0" Padding="8,6">
                <Grid>
                    <TextBlock x:Name="Status" Style="{StaticResource SecondaryText}" Margin="14,11"
                               Text="Загружаем описание релиза…" AutomationProperties.LiveSetting="Polite" />
                    <FlowDocumentScrollViewer x:Name="ReleaseText" Visibility="Collapsed" Background="Transparent"
                                              BorderThickness="0" HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"
                                              AutomationProperties.Name="Описание релиза">
                        <FlowDocument PagePadding="14,10,14,3" FontFamily="Segoe UI" FontSize="14" LineHeight="22"
                                      Foreground="{StaticResource Text}" TextAlignment="Left" />
                    </FlowDocumentScrollViewer>
                </Grid>
            </Border>
        </DockPanel>
    </Border>
</Window>
