<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.1.9</Version>
    <ApplicationIcon>CoreShift.ico</ApplicationIcon>
    <ApplicationManifest Condition="'$(Configuration)' != 'Debug'">app.manifest</ApplicationManifest>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" GeneratePathProperty="true" />
    <ProjectReference Include="../SmartResourceDispatcher.csproj" />
    <EmbeddedResource Include="Assets/OperationComplete.wav" LogicalName="CoreShift.OperationComplete.wav" />
    <EmbeddedResource Include="Web/*" LogicalName="CoreShift.Web.%(Filename)%(Extension)" />
    <None Update="ThirdPartyNotices.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
    <None Include="$(PkgMicrosoft_Web_WebView2)/LICENSE.txt" Link="WebView2-License.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="$(PkgMicrosoft_Web_WebView2)/NOTICE.txt" Link="WebView2-Notice.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <Target Name="ConfigureDesktopBundle" BeforeTargets="_ComputeFilesToBundle">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.RelativePath)' == 'SmartResourceDispatcher.runtimeconfig.json'
                  or '%(ResolvedFileToPublish.RelativePath)' == 'SmartResourceDispatcher.deps.json'
                  or '%(ResolvedFileToPublish.RelativePath)' == 'SmartResourceDispatcher.exe'" />
      <!-- Keep WPF's mixed-mode assemblies and their native imports beside the executable. -->
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" ExcludeFromSingleFile="true"
          Condition="'%(ResolvedFileToPublish.RelativePath)' == 'DirectWriteForwarder.dll'
                  or '%(ResolvedFileToPublish.RelativePath)' == 'System.Printing.dll'
                  or '%(ResolvedFileToPublish.RelativePath)' == 'ijwhost.dll'
                  or '%(ResolvedFileToPublish.RelativePath)' == 'vcruntime140_cor3.dll'" />
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" ExcludeFromSingleFile="true"
          Condition="'%(ResolvedFileToPublish.RelativePath)' == 'LibreHardwareMonitorLib.dll'
                  or '%(ResolvedFileToPublish.Filename)' == 'WebView2Loader'" />
    </ItemGroup>
  </Target>
</Project>
